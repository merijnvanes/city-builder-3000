# Response headers for the deployed site. Cloudflare Pages and Netlify both read
# this file from the root of the build output; everything in public/ is copied
# there, so this lands as dist/_headers. Any other host needs the same rules
# expressed its own way.
#
# The split below is the whole point. Every file under /assets carries a content
# hash in its name, put there by Vite for the code and by
# tools/civic_art/package.py for the artwork, so its URL changes whenever its
# bytes do and a browser can keep it forever. The pages have fixed URLs and name
# those hashed files, so they must be checked on every load. Cache a page and a
# returning player gets an index pointing at a bundle that no longer exists.
#
# No path may match two rules that both set the same header. Cloudflare Pages
# appends the second value rather than replacing the first, so an attempt to
# narrow /assets/* for one file would send both policies at once and browsers
# that honour `immutable` would keep the file for a year regardless. Anything
# that cannot be cached forever therefore lives outside /assets, and
# tests/deploy-headers.test.js checks that no rules overlap.

# Everything the site is allowed to do, for every path it serves.
#
# The game loads nothing from anywhere else: no analytics, no fonts from a CDN,
# no runtime dependencies, and it never calls out. The policy says exactly that,
# so an injected script or an image beacon has nowhere to send anything. It also
# needs no 'unsafe-inline': the pages carry no inline script or style, and the
# one <p style> in the report was moved to a class to keep it that way.
#
# connect-src covers the gallery reading /civic-catalog.json. img-src allows
# data: for the empty inline favicons. media-src is none because the soundtrack
# is generated with the Web Audio API rather than loaded. worker-src is 'self'
# for the service worker and nothing else; left out it would fall back to
# script-src, which is the same value by accident rather than on purpose.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'none'; worker-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# max-age=0 with must-revalidate still allows a conditional request, so an
# unchanged page comes back as a 304 rather than a fresh megabyte.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Cloudflare Pages serves pages at their clean URL and matches these rules
# against the path the browser asked for, so both spellings need the rule.
/civic-gallery
  Cache-Control: public, max-age=0, must-revalidate

/civic-gallery.html
  Cache-Control: public, max-age=0, must-revalidate

# The artwork catalogue the gallery page reads, and the gallery's own stylesheet
# and script. All keep fixed names and change with the page that uses them.
/civic-catalog.json
  Cache-Control: public, max-age=0, must-revalidate

/civic-gallery.css
  Cache-Control: public, max-age=0, must-revalidate

/civic-gallery.js
  Cache-Control: public, max-age=0, must-revalidate

# The service worker decides what every later request is answered with, so a
# cached copy of it would outlive the deploy that replaced it.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# The loading screen's stylesheet and the script that notices a bundle which
# never arrives. Both are linked from index.html so they are in effect before the
# bundle has run, and both keep fixed names, like the page that names them.
/boot.css
  Cache-Control: public, max-age=0, must-revalidate

/boot.js
  Cache-Control: public, max-age=0, must-revalidate

# The font's licence. It has no hash in its name, so it gets a day rather than a
# year; the font itself is a hashed build asset covered above.
/fonts/*
  Cache-Control: public, max-age=86400
